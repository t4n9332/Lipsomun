# Neon/Vercel Postgres 연결 문자열
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 관리자 페이지 비밀번호 (원하는 값으로 변경)
ADMIN_PASSWORD="change-me"

# 쿠팡파트너스 Open API 키 (파트너스 > 링크생성 > Open API에서 발급)
COUPANG_ACCESS_KEY=""
COUPANG_SECRET_KEY=""
# 채널 구분용 서브 ID (선택)
COUPANG_SUB_ID="ipsomun"

# 링크프라이스 어필리에이트 ID (ac.linkprice.net > 내 정보에서 확인, 보통 A100xxxxx 형태)
LINKPRICE_AFFILIATE_ID=""

# 텔레그램 특가 채널 자동 발송 (@BotFather에서 봇 생성 → 토큰, 채널에 봇을 관리자로 추가)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 토스쇼핑 쉐어링크 Open API (sharelink.toss.im > API 연동 메뉴에서 발급)
# ⚠️ API를 호출하는 서버(Vercel)의 출발지 IP를 쉐어링크 어드민에 등록해야 합니다.
TOSS_SHARELINK_ACCESS_KEY=""
TOSS_SHARELINK_SECRET_KEY=""
TOSS_SHARELINK_PUBLISHER_ID=""

# 골드박스 자동 갱신 크론 보호용 임의 문자열 (아무 랜덤 값이나 가능)
CRON_SECRET=""

# 구글 로그인 (console.cloud.google.com > OAuth 클라이언트 ID 생성)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 세션 서명용 임의 문자열
AUTH_SECRET=""

# 웹푸시 VAPID 키 (npx web-push generate-vapid-keys 로 생성)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:본인이메일@gmail.com"
